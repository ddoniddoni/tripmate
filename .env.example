# Canonical public URL used to build absolute application links.
NEXT_PUBLIC_APP_URL=

# Browser-safe Mapbox token. Required only after map integration is enabled.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Browser-safe Supabase project URL. Required for email login and later persistence.
NEXT_PUBLIC_SUPABASE_URL=

# Preferred browser-safe Supabase key. `sb_publishable_...` values are safe to expose with RLS enabled.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy browser-safe key, supported temporarily for existing projects. Do not set this when using a publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Liveblocks key. Never expose this with a NEXT_PUBLIC_ prefix.
LIVEBLOCKS_SECRET_KEY=

# Server-only OpenAI API key for production AI itinerary drafts. Never expose this with a NEXT_PUBLIC_ prefix.
# When empty in local development, TripMate shows a clearly labeled mock itinerary preview with no API call.
OPENAI_API_KEY=

# Server-only Google Maps Platform key. Enable Places API (New) and Routes API; never expose this with a NEXT_PUBLIC_ prefix.
GOOGLE_MAPS_API_KEY=

# Optional server-side hard limits for Google Places Text Search. Defaults: 100 per day and 1,000 per month.
GOOGLE_PLACES_SEARCH_DAILY_LIMIT=100
GOOGLE_PLACES_SEARCH_MONTHLY_LIMIT=1000

# Optional server-side hard limits for Google Place Details. Defaults: 20 per day and 100 per month.
# This is requested only when someone explicitly opens a place's detailed information.
GOOGLE_PLACES_DETAILS_DAILY_LIMIT=20
GOOGLE_PLACES_DETAILS_MONTHLY_LIMIT=100

# Optional server-side hard limits for Google Routes API. Defaults: 100 per day and 1,000 per month.
GOOGLE_ROUTES_DAILY_LIMIT=100
GOOGLE_ROUTES_MONTHLY_LIMIT=1000

# Browser-safe Google Maps JavaScript API key. Restrict it to this website's origins and the Maps JavaScript API only.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_KEY=

# Optional server-side hard limits for displaying Google Maps. Defaults: 250 per day and 8,000 per month.
GOOGLE_MAPS_JAVASCRIPT_DAILY_LIMIT=250
GOOGLE_MAPS_JAVASCRIPT_MONTHLY_LIMIT=8000

# Server-only Supabase service role key. Never expose this with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
